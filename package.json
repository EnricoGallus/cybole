{
  "name": "cybole",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "author": "Enrico Gallus <enrico.gallus@gmail.com>",
  "description": "Editor for CYBOL-Projects",
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-store": "^2.5.0",
    "events": "^3.3.0",
    "fast-xml-parser": "^4.0.12",
    "primeflex": "^3.3.0",
    "primeicons": "^6.0.1",
    "primereact": "^10.9.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6",
    "react-xml-editor": "^0.10.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^26.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "build": "yarn typecheck && vite build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test vite.config.ts vitest.config.ts playwright.config.ts .eslintrc.cjs --ext .ts,.tsx,.cjs",
    "lint:fix": "yarn lint --fix",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:EnricoGallus/cybole.git"
  },
  "bugs": {
    "url": "https://github.com/EnricoGallus/cybole/issues"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24 <27"
  }
}
