    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-store": "^2.5.0",
    "fast-xml-parser": "^4.0.12",
    "primeflex": "^3.3.0",
    "primeicons": "^6.0.1",
    "primereact": "^10.9.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6",
    "react-xml-editor": "^0.10.4",
    "events": "^3.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "build": "yarn typecheck && vite build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint src test vite.config.ts jest.config.ts .eslintrc.cjs --ext .ts,.tsx,.cjs",
    "lint:fix": "yarn lint --fix"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:EnricoGallus/cybole.git"
  },
  "bugs": {
    "url": "https://github.com/EnricoGallus/cybole/issues"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24 <27"
  }
